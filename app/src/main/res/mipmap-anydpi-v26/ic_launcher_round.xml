<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante ronde, désignée par `android:roundIcon` dans le manifeste (B24).

  Contenu identique à `ic_launcher.xml`, et ce n'est pas un oubli : avec une icône
  adaptative, c'est le lanceur qui découpe la forme, l'application n'a pas à fournir deux
  dessins. Le fichier existe parce que quelques lanceurs constructeurs lisent encore
  `roundIcon` en priorité ; sans lui, ceux-là retomberaient sur l'icône par défaut du
  système.

  Si le dessin change, changer les deux — ou plutôt : changer `ic_launcher_foreground.xml`,
  que les deux partagent, et ne toucher à aucun des deux.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
