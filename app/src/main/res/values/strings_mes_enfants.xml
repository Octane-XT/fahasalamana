<?xml version="1.0" encoding="utf-8"?>
<!--
  Textes de l'écran « Mes enfants » (B06). Fichier séparé de strings.xml, et non une
  section de plus dedans : Android fusionne tous les fichiers de res/values/, et deux
  développeurs qui écrivent un écran en parallèle ne s'écrasent alors pas l'un l'autre.
  Mêmes règles que strings.xml : interface en français, ton factuel et non culpabilisant
  (règle R7) — « À faire », « Prochaine dose : … », jamais « Vous avez oublié ».
-->
<resources>

    <!-- B06 — Écran Mes enfants : liste et actions (US-B8) -->
    <string name="mes_enfants_titre">Mes enfants</string>
    <string name="mes_enfants_action_ajouter">Ajouter un enfant</string>
    <!-- B23 — Ce que fait l'appui sur une carte, annoncé par TalkBack (`onClickLabel`) :
         un élément cliquable dit ce qu'il fait, pas seulement ce qu'il affiche. -->
    <string name="mes_enfants_action_ouvrir">Ouvrir le carnet</string>

    <!-- B06 — État vide : premier lancement, aucun enfant enregistré -->
    <string name="mes_enfants_vide_titre">Ajoutez votre premier enfant</string>
    <string name="mes_enfants_vide_description">Le carnet se remplit tout seul : à partir de la date de naissance, l\'application calcule la date de chaque vaccin.</string>

    <!-- B06 — État d'erreur : aucune donnée personnelle dans ce message -->
    <string name="mes_enfants_erreur">La liste des enfants n\'a pas pu être lue.</string>

    <!-- B06 — Résumé par enfant (règle R6). Chaque puce est doublée d'une icône. -->
    <string name="mes_enfants_a_jour">À jour</string>
    <plurals name="mes_enfants_nb_en_retard">
        <item quantity="one">%1$d en retard</item>
        <item quantity="other">%1$d en retard</item>
    </plurals>
    <plurals name="mes_enfants_nb_a_faire">
        <item quantity="one">%1$d à faire</item>
        <item quantity="other">%1$d à faire</item>
    </plurals>

    <!-- B06 — Prochaine échéance : %1$s nom du vaccin, %2$s dose, %3$s date.
         B23 — « Prochaine dose » remplace « Prochain » : la fiche de l'enfant écrivait la
         même idée avec d'autres mots. Le wireframe §B7.2, basse fidélité, note « prochain :
         RR1 le 28/09 » ; aucun des deux écrans ne reprenait ce raccourci mot pour mot. -->
    <string name="mes_enfants_prochain">Prochaine dose : %1$s %2$s, le %3$s</string>
    <string name="mes_enfants_prochain_date_seule">Prochaine dose : le %1$s</string>
    <string name="mes_enfants_prochain_aucun">Toutes les doses du calendrier sont faites</string>

    <!-- B06 — Âge de l'enfant : les clés `mes_enfants_age_*` ont été retirées. La fiche
         enfant écrivait les mêmes âges avec ses propres textes et son propre seuil, et les
         deux écrans se contredisaient. Un seul jeu de clés désormais, `age_*` dans
         strings.xml, écrit par `ui/components/TexteAge.kt`. -->

    <!-- B06 (correction) — Calendrier de référence pas encore chargé, ou inexploitable :
         aucune date n'est calculable pour cet enfant. La carte ne doit surtout pas annoncer
         « À jour », qui est faux et rassurant à tort.
         Même situation que la fiche enfant, donc mêmes mots : la seconde chaîne est celle de
         `fiche_calendrier_absent_titre`, recopiée ici plutôt que partagée, comme
         `fiche_introuvable_*` et `edition_introuvable_*` le font déjà — chaque écran garde
         ses clés, et les deux fichiers portent la même phrase.
         Ton R7 : on décrit l'état du téléphone, on ne demande rien à la mère. -->
    <string name="mes_enfants_calendrier_absent_puce">En attente du calendrier</string>
    <string name="mes_enfants_calendrier_absent">Le calendrier vaccinal n\'est pas encore chargé</string>

</resources>
