<?xml version="1.0" encoding="utf-8"?>
<!--
  Textes de l'export du carnet (tâche B16, US-B9 scénario 1). Fichier distinct de
  strings.xml : Android fusionne tous les fichiers de res/values/, ce qui permet aux deux
  développeurs d'ajouter leurs textes en parallèle sans se marcher dessus. B17 ajoutera les
  siens à la fin de ce fichier, préfixés `import_`.

  Le libellé de l'action elle-même n'est pas ici : c'est `reglages_export` (« Exporter le
  carnet »), déjà écrit par B15 pour la place réservée, et repris tel quel — c'est le mot à
  mot du scénario. En créer un second laisserait une clé orpheline dans strings.xml.

  Ton factuel et non culpabilisant (règle R7), et une contrainte de plus propre à cet
  écran : ces phrases parlent d'un fichier de santé qui sort du téléphone. Elles disent ce
  que l'application fait et ce qu'elle ne fait pas, sans promesse au-delà du code — pas de
  « sécurisé », pas de « chiffré » (le §B8 renvoie le chiffrement à une V2), pas de
  « sauvegarde » qui laisserait croire à une copie tenue à jour ailleurs.
-->
<resources>

    <!-- B16 — Entrée « Exporter le carnet » du bloc Carnet des Réglages -->
    <string name="export_description">Enregistre vos enfants et leurs vaccins dans un fichier, à l\'emplacement que vous choisissez.</string>
    <string name="export_en_cours">Écriture du fichier en cours…</string>
    <string name="export_fermer">Fermer</string>

    <!-- B16 — Export réussi. Le détail compte ce qu'il y a réellement dans le fichier. -->
    <string name="export_reussi_titre">Carnet exporté</string>
    <string name="export_reussi_detail">Le fichier contient %1$s et %2$s.</string>
    <plurals name="export_nb_enfants">
        <item quantity="one">%1$d enfant</item>
        <item quantity="other">%1$d enfants</item>
    </plurals>
    <plurals name="export_nb_doses">
        <item quantity="one">%1$d vaccin enregistré</item>
        <item quantity="other">%1$d vaccins enregistrés</item>
    </plurals>

    <!-- B16 — La phrase exigée par US-B9 : « un message confirme que le fichier ne contient
         aucune donnée envoyée ailleurs ». Elle dit les trois choses qui comptent : où est le
         fichier, que rien n'est parti, et qu'il est lisible tel quel (§B8, point 3). -->
    <string name="export_reussi_confidentialite">Le fichier reste là où vous venez de l\'enregistrer. L\'application ne l\'envoie nulle part et n\'en garde aucune copie. Il contient des données de santé lisibles telles quelles : gardez-le en lieu sûr.</string>

    <!-- B16 — Rien à exporter : le sélecteur de fichiers n'est pas ouvert. -->
    <string name="export_vide_titre">Aucun enfant à exporter</string>
    <string name="export_vide_detail">Ajoutez d\'abord un enfant dans l\'onglet Enfants.</string>

    <!-- B16 — Échec d'écriture. Aucun détail technique, aucune donnée personnelle. -->
    <string name="export_echec_titre">Le fichier n\'a pas été écrit</string>
    <string name="export_echec_detail">L\'emplacement choisi n\'a pas pu être utilisé. Vous pouvez réessayer et choisir un autre dossier.</string>

    <!-- ===================================================================
         B17 — Import d'un carnet (US-B9, scénario 2)

         Deux contraintes de ton s'ajoutent à la règle R7 pour ces textes-là.

         1. L'import est la seule opération de l'application qui écrit en masse dans le
            carnet. Chaque message dit donc ce qui a changé, ou dit explicitement que rien
            n'a changé : « Rien n'a été modifié dans votre carnet » figure dans les trois
            messages de refus, parce que c'est la question que se pose le parent.
         2. La fusion ne remplace jamais rien (voir domain/ImportCarnet.kt). Les textes
            n'emploient donc ni « mis à jour », ni « remplacé », ni « synchronisé » : le
            vocabulaire est « ajouté » / « déjà enregistré ». Promettre une mise à jour que
            le code ne fait pas serait pire qu'un compteur de moins.

         Le bouton de fermeture réutilise `export_fermer` : même mot, même geste.
         =================================================================== -->

    <!-- Le libellé de l'action est `reglages_import` (« Importer un carnet »), déjà écrit
         par B15 pour la place réservée et repris tel quel. -->
    <string name="import_description">Ajoute à votre carnet les enfants et les vaccins d\'un fichier exporté. Ce qui est déjà sur ce téléphone est conservé tel quel.</string>
    <string name="import_en_cours">Lecture du fichier en cours…</string>

    <!-- Import réussi. Les compteurs décrivent ce qui vient d'entrer dans le carnet. -->
    <string name="import_reussi_titre">Carnet importé</string>
    <string name="import_reussi_enfants">Enfants : %1$s, %2$s.</string>
    <string name="import_reussi_doses">Vaccins : %1$s, %2$s.</string>
    <plurals name="import_nb_enfants_ajoutes">
        <item quantity="one">%1$d ajouté</item>
        <item quantity="other">%1$d ajoutés</item>
    </plurals>
    <plurals name="import_nb_enfants_fusionnes">
        <item quantity="one">%1$d déjà enregistré</item>
        <item quantity="other">%1$d déjà enregistrés</item>
    </plurals>
    <plurals name="import_nb_doses_ajoutees">
        <item quantity="one">%1$d ajouté</item>
        <item quantity="other">%1$d ajoutés</item>
    </plurals>
    <plurals name="import_nb_doses_fusionnees">
        <item quantity="one">%1$d déjà enregistré</item>
        <item quantity="other">%1$d déjà enregistrés</item>
    </plurals>

    <!-- Lignes en double dans le fichier lui-même : signalées parce qu'elles disent que le
         fichier est anormal, sans quoi les compteurs sembleraient faux. -->
    <plurals name="import_nb_lignes_ignorees">
        <item quantity="one">%1$d ligne était en double dans le fichier : elle n\'a été lue qu\'une fois.</item>
        <item quantity="other">%1$d lignes étaient en double dans le fichier : elles n\'ont été lues qu\'une fois.</item>
    </plurals>

    <!-- La replanification des rappels fait partie du scénario 2 (« les rappels sont
         recalculés ») : le parent doit savoir qu'il n'a rien à faire de plus.
         Cette phrase n'est écrite que si la replanification a réellement abouti : sur un
         carnet de vaccination, c'est elle qui dit au parent qu'il sera prévenu. -->
    <string name="import_rappels_recalcules">Les rappels de vaccination ont été recalculés pour tous les enfants.</string>

    <!-- Les trois textes du cas où elle échoue. Se taire laisserait croire que tout va bien,
         et reprendre la phrase du dessus serait un mensonge. Ils ne mettent rien sur le dos
         de l'utilisateur (R7), ne donnent aucun détail technique, et disent le geste qui y
         remédie : la replanification se retente seule, sans refaire l'import.
         Comme `import_rappels_recalcules`, ils sont repris tels quels par B19 après un
         nouveau calendrier — même situation, mêmes mots (voir strings_maj_reference.xml). -->
    <string name="import_rappels_non_recalcules">En revanche, les rappels de vaccination n\'ont pas pu être reprogrammés : les notifications à venir manquent pour l\'instant. Elles reviendront d\'elles-mêmes à la prochaine saisie de vaccin, ou tout de suite avec le bouton ci-dessous.</string>
    <string name="import_rappels_reessayer">Reprogrammer les rappels</string>
    <string name="import_rappels_en_cours">Reprogrammation des rappels…</string>

    <!-- Ce qui reste vrai malgré cet échec, du côté de l'import : la fusion est écrite. C'est
         la première phrase lue, avant celle qui dit ce qui manque. -->
    <string name="import_rappels_echec_carnet">Les enfants et les vaccins du fichier sont bien enregistrés dans votre carnet.</string>

    <!-- Ce que l'application a fait du fichier, et ce qu'elle n'en a pas fait (§B8). -->
    <string name="import_reussi_confidentialite">L\'application a seulement lu ce fichier : elle ne l\'a ni déplacé, ni modifié, ni envoyé ailleurs. Il reste là où vous l\'avez enregistré.</string>

    <!-- Tout ce que portait le fichier était déjà là : le carnet n'a pas changé. -->
    <string name="import_rien_ajoute_titre">Rien de nouveau à importer</string>
    <string name="import_rien_ajoute_detail">Tout ce que contient ce fichier est déjà dans votre carnet.</string>

    <!-- Fichier lisible, mais sans aucun enfant : sans doute le mauvais fichier. -->
    <string name="import_vide_titre">Aucun enfant dans ce fichier</string>
    <string name="import_vide_detail">Ce fichier est bien un carnet, mais il ne contient aucun enfant. Rien n\'a été modifié dans votre carnet.</string>

    <!-- Fichier non reconnu : aucun détail technique, aucun extrait du fichier. -->
    <string name="import_illisible_titre">Fichier non reconnu</string>
    <string name="import_illisible_detail">Ce fichier n\'est pas un carnet exporté par l\'application, ou il a été abîmé pendant son transfert. Rien n\'a été modifié dans votre carnet.</string>

    <!-- Format inconnu : le fichier vient d'une version plus récente de l'application. -->
    <string name="import_version_titre">Fichier d\'une autre version</string>
    <string name="import_version_detail">Ce carnet est écrit dans un format que cette version de l\'application ne sait pas lire (format %1$d). Rien n\'a été modifié dans votre carnet : installez la dernière version de l\'application, puis réessayez.</string>

    <!-- Échec de lecture du document ou d'écriture en base. Rien n'est écrit à moitié :
         la fusion est une transaction. -->
    <string name="import_echec_titre">Le fichier n\'a pas été lu</string>
    <string name="import_echec_detail">Le fichier choisi n\'a pas pu être ouvert. Votre carnet est resté tel qu\'il était ; vous pouvez réessayer.</string>

</resources>
