<?xml version="1.0" encoding="utf-8"?>
<!--
  Thème minimal du manifeste : il ne sert qu'à la fenêtre avant la première image
  Compose. L'apparence réelle vient de FahasalamanaTheme (ui/theme/Theme.kt), posé par
  MainActivity. Parent android:Theme.Material.Light.NoActionBar pour éviter une
  dépendance à AppCompat dans un projet 100 % Compose.

  B23 — L'éclair blanc au lancement en mode sombre est corrigé : le fond de fenêtre pointe
  sur `@color/fenetre_demarrage`, que `values-night/colors.xml` redéfinit en sombre. Un
  `values-night/themes.xml` complet n'est pas nécessaire — seul le fond est visible pendant
  ce court instant, le reste du thème système n'est jamais dessiné.
-->
<resources>

    <style name="Theme.Fahasalamana" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fenetre_demarrage</item>
    </style>

</resources>
