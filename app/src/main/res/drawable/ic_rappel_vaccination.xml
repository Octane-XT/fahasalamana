<?xml version="1.0" encoding="utf-8"?>
<!--
  Petite icône des notifications de rappel (B10).

  Une croix de santé, pleine et sans détail : Android ne garde que l'alpha d'une petite
  icône de notification et la reteinte lui-même. Tout dégradé, toute couleur et tout trait
  fin y disparaîtraient — d'où une forme volontairement massive, lisible à 24 dp dans la
  barre d'état.

  Ce fichier ne sert qu'aux notifications. L'icône de lanceur, ajoutée en B24, reprend la
  même croix à une autre échelle : mipmap-anydpi-v26/ic_launcher.xml et
  drawable/ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10,3h4v7h7v4h-7v7h-4v-7H3v-4h7z" />
</vector>
