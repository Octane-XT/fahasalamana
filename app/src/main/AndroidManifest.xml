<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rappels de vaccination (Android 13+). Demandée à l'exécution au premier ajout
         d'enfant, précédée d'une explication maison (B10, CDC §B8) : voir
         platform/PermissionNotifications.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Uniquement pour la mise à jour du calendrier et de l'annuaire (B19).
         Aucune donnée personnelle ne transite par le réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Intents résolus par l'application : cartes et téléphone (B14). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fahasalamana">
        <!-- Le carnet contient des données de santé : il ne part ni dans une sauvegarde
             cloud ni dans un transfert d'appareil (CDC §B8, point 5). Cette phrase demande
             trois attributs, et non un seul, parce qu'Android a changé de mécanisme en
             cours de route (B24) :

               - allowBackup="false"      coupe la sauvegarde automatique ;
               - fullBackupContent="false" est la forme lue par Android 11 et moins ;
               - dataExtractionRules       est la seule lue par Android 12 et plus, et la
                                           seule qui régisse le transfert d'appareil à
                                           appareil. Sans elle, sur une partie du parc, un
                                           téléphone neuf recopierait la base entière.

             Les règles elles-mêmes, et la raison de chacune : res/xml/data_extraction_rules.xml. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Fahasalamana">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- (B10) Lien profond des notifications de rappel : fahasalamana://enfant/{enfantId}
                 (CDC §B7.1). Le schéma et l'hôte sont les mêmes deux chaînes que dans
                 platform/LienNotification.kt et que dans le navDeepLink de la destination
                 FicheEnfant ; les faire diverger casserait le lien sans le moindre message.

                 Schéma privé et non https : aucun site ne porte ce nom, il n'y a donc ni
                 App Links à vérifier, ni fichier assetlinks.json à publier — et surtout
                 aucune chance qu'un identifiant d'enfant parte dans une barre d'adresse.
                 BROWSABLE reste nécessaire pour qu'un lien touché hors de l'application
                 (notification, `adb shell am start`) atteigne l'activité. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="enfant"
                    android:scheme="fahasalamana" />
            </intent-filter>
        </activity>

        <!-- WorkManager s'initialise tout seul au démarrage du processus, avant
             App.onCreate. Koin doit lui fournir sa propre fabrique de workers pour que
             RappelWorker reçoive ses dépendances : on retire donc l'initialisation
             automatique, sinon `workManagerFactory()` échoue sur une instance déjà créée
             et l'application s'arrête au lancement. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
