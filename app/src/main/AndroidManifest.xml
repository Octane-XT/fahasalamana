<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rappels de vaccination (Android 13+). Demandée à l'exécution, TODO(B10). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Uniquement pour la mise à jour du calendrier et de l'annuaire (B19).
         Aucune donnée personnelle ne transite par le réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Intent résolu par l'application : le composeur téléphonique (B14). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <!-- Le filtre du composeur exige le schéma tel : sans lui, l'appariement de
                 visibilité d'Android 11+ ne le trouve pas et resolveActivity renvoie null. -->
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fahasalamana">
        <!-- allowBackup=false : le carnet contient des données de santé, il ne part
             ni dans une sauvegarde cloud ni dans un transfert d'appareil (CDC §B8).
             TODO(B24) : ajouter android:dataExtractionRules pour Android 12+. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Fahasalamana">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TODO(B10) : deep link fahasalamana://enfant/{id} depuis la notification. -->
        </activity>

        <!-- WorkManager s'initialise tout seul au démarrage du processus, avant
             App.onCreate. Koin doit lui fournir sa propre fabrique de workers pour que
             RappelWorker reçoive ses dépendances : on retire donc l'initialisation
             automatique, sinon `workManagerFactory()` échoue sur une instance déjà créée
             et l'application s'arrête au lancement. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
